# =====================================================================
#  HBS Suite API (Express + MySQL + Redis + BullMQ)
#  cp .env.example .env
# =====================================================================

# ---------- HTTP server ----------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Public URL of the app (the React site). Used in emails, OAuth redirects, share links.
# With the recommended Nginx setup the API lives on the same domain under /api.
APP_URL=http://localhost:5173
# Browser origins allowed to call the API with cookies (comma separated)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front (Nginx = 1) - needed for real client IPs
TRUST_PROXY=1
BODY_LIMIT=30mb
# Global per-IP API flood guard (requests / minute, shared across instances via Redis)
API_RATE_LIMIT_PER_MIN=600
# Optional: share the session cookie across subdomains (e.g. .hbssuite.com)
COOKIE_DOMAIN=

# ---------- Redis (cache, rate limit, BullMQ queues) ----------
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=hbs
# Seconds dashboard / analytics aggregates are cached per tenant
VIEW_STATS_TTL=30
VIEW_PUBLIC_TTL=60

# ---------- Worker (npm run worker) ----------
TZ=Asia/Kolkata
AI_WORKER_CONCURRENCY=1
MAIL_CONCURRENCY=2
PUBLISH_CONCURRENCY=1
MAINTENANCE_CONCURRENCY=2
MAIL_BATCH=25
MAIL_WORKER_INTERVAL_MS=10000
CALENDAR_POST_CRON=*/2 * * * *
# Comma separated job names to switch off (see: npm run job -- list)
DISABLED_JOBS=

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gmb_ai
DB_POOL_LIMIT=20
# ---------- Auth ----------
SESSION_SECRET=change-me-openssl-rand-hex-32

# ---------- Ollama (free, local text + embeddings) ----------
# Text for every agent runs on Ollama while it is reachable; if it is off / down /
# too slow, everything falls back to Gemini automatically. Images never use Ollama.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# CPU models are slow - per-call timeout for Ollama (default 180000)
OLLAMA_TIMEOUT_MS=300000
# context window per call (prompts include the business knowledge)
OLLAMA_NUM_CTX=8192
# Ollama post still too short after "expand" -> one Gemini call for that post (gemini | off)
OLLAMA_SHORT_FALLBACK=gemini
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------- OpenAI (server-side only, primary paid provider) ----------
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# ---------- Gemini (server-side only; text fallback when Ollama is down, the image provider) ----------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------- Groq (fast text - takes over when Gemini quota / balance is finished) ----------
# https://console.groq.com/keys  (or Admin -> Integrations -> Groq)
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=45000

# ---------- Cloudflare Workers AI (images - FLUX.1 schnell, fallback after Gemini) ----------
# Account ID: dash.cloudflare.com right sidebar. Token: My Profile -> API Tokens -> "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# 1-8, higher = better quality, slower
CLOUDFLARE_IMAGE_STEPS=6
# 0 = never fall back to Cloudflare for images
IMAGE_FALLBACK_CLOUDFLARE=1

# ---------- Hugging Face (server-side only, fallback provider) ----------
HF_API_KEY=
HF_TEXT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=auto
# Text provider:
#   auto (default) = Ollama (if enabled + reachable) -> Gemini -> OpenAI -> Hugging Face -> Mock
#   ollama         = Ollama -> Gemini -> Mock   (Gemini is the safety net)
#   gemini         = Gemini -> Groq (+ Mock)     | groq = Groq -> Gemini | openai | huggingface | mock = force one
AI_PROVIDER=auto
# Which AI writes post text when nobody picks (nightly / calendar / auto-schedule):
#   hybrid (default) = post text (content + humanize) on Gemini, research/keywords/topic/QA on Ollama
#   ollama = all on Ollama | gemini = all on Gemini | groq = all on Groq. Manual runs ask in the app.
AI_BACKGROUND_ENGINE=hybrid
# Agents that go to Gemini in hybrid mode
HYBRID_GEMINI_AGENTS=content,humanize
# Reuse a client's research / keyword research instead of asking the AI every post (0 = always run)
RESEARCH_CACHE_DAYS=7
KEYWORD_CACHE_DAYS=3
# Image provider: gemini (default: Gemini -> Cloudflare) | cloudflare (Cloudflare -> Gemini) | auto (Gemini -> Cloudflare -> OpenAI -> HF) | openai | huggingface
IMAGE_PROVIDER=gemini
# Max AI image regenerations allowed per GMB post (manual upload is unlimited)
IMAGE_REGEN_LIMIT=2
# One image per post / per click (cost). "Regenerate" on a post keeps its image.
IMAGE_OPTIONS_COUNT=1
IMAGE_OPTIONS_COUNT_MAX=1
AI_TIMEOUT_MS=45000
AI_IMAGE_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_JOB_CONCURRENCY=3
# Budget-tier text model rates (per project cost doc, Aug 2026 - reconfirm before budget approval)
AI_COST_PER_1K_INPUT=0.0006
AI_COST_PER_1K_OUTPUT=0.0024
AI_COST_PER_IMAGE=0.003
# ---------- Image storage (server-side only) ----------
# Fallback chain, tried in order until one succeeds: AWS S3 -> Cloudflare R2
# -> Cloudinary -> local disk (always available, last resort).
# Leave STORAGE_PROVIDER blank to use the chain; set it to force one.
STORAGE_PROVIDER=

# AWS S3
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CloudFront/custom domain in front of the bucket - defaults to the
# bucket's own regional S3 URL if left blank.
AWS_S3_PUBLIC_URL=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_BUCKET=gmb-api
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required - R2 buckets are private by default. Use an r2.dev subdomain you've
# enabled (Bucket -> Settings -> Public access) or your own custom domain.
R2_PUBLIC_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Local disk (last resort fallback - always on, no keys needed)
IMAGE_STORAGE_DIR=

# Every AI-generated/uploaded image older than this gets deleted from storage.
# A still-PUBLISHED post's live image is skipped by default so a routine sweep
# never breaks a live GMB listing - set the skip flag to false to delete
# unconditionally after IMAGE_RETENTION_DAYS regardless of publish status.
IMAGE_RETENTION_DAYS=90
IMAGE_RETENTION_SKIP_PUBLISHED=true

# ---------- GMB ----------
# mock | google   (google provider is a stub until OAuth is configured)
GMB_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMB_ACCOUNT_ID=
GOOGLE_INVITE_DAYS=14
# ---------- Scheduled jobs (cron, TZ above) ----------
NIGHTLY_CRON=0 0 * * *
# Daily image retention sweep (deletes images older than IMAGE_RETENTION_DAYS)
IMAGE_CLEANUP_CRON=0 2 * * *
# ---------- SaaS ----------
# Billing sweep: renews, raises invoices, expires past-due subscriptions
BILLING_CRON=30 1 * * *
# ---------- Email (SMTP via nodemailer) ----------
# Any SMTP provider works: Gmail (use an App Password, not your normal
# password), SendGrid, Mailgun, Amazon SES SMTP, Brevo, Resend SMTP, etc.
# If left blank, emails are logged to the console instead of sent (dev mode) -
# nothing crashes, but nobody actually receives mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GMB AI Cloud <no-reply@yourdomain.com>

# ---------- OTP / Two-factor login ----------
# Minutes before an emailed OTP code expires (login 2FA + password reset)
OTP_EXPIRY_MINUTES=10

# ---------- Background email worker ----------
# How often scripts/scheduler.js drains the email_queue table and sends via
# SMTP. Cron syntax. Every request just inserts a row and returns instantly;
# the BullMQ "mail.drain" job (npm run worker) does the actual sending so
# signup/login/publish never wait on SMTP. Interval: MAIL_WORKER_INTERVAL_MS above.

# ---------- Debug ----------
# 1 = verbose AI request/response tracing in server logs
AI_DEBUG=0

# ---------- Security (v5) ----------
# 32+ random chars. Encrypts integration secrets & FCM tokens at rest. Changing it makes stored secrets unreadable.
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Pepper for API-key / share-link hashes (defaults to SESSION_SECRET)
API_KEY_PEPPER=

# ---------- Payments (optional - prefer Admin -> Integrations) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Firebase Cloud Messaging (optional - prefer Admin -> Integrations) ----------
# Web config + VAPID key are entered in Admin -> Integrations -> Firebase.
FIREBASE_PROJECT_ID=
# Service account JSON on ONE line (or paste it in Admin -> Integrations)
FIREBASE_SERVICE_ACCOUNT=

# ---------- Google OAuth ----------
GOOGLE_REDIRECT_URI=http://localhost:5173/api/gmb/callback
# "Continue with Google" login - add this URI to the same OAuth client (defaults to APP_URL + path)
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ---------- Reports / support storage ----------
REPORT_STORAGE_DIR=
REPORT_LINK_DAYS=30
SUPPORT_STORAGE_DIR=

# ---------- Scheduler ----------
HOUSEKEEPING_CRON=30 2 * * *
HEALTH_CRON=5 * * * *
REVIEW_SYNC_CRON=*/30 * * * *
LISTING_HEALTH_CRON=0 3 * * *

# ---------- Auto-publish ----------
APP_TIMEZONE=Asia/Kolkata
AUTO_PUBLISH_CRON=*/5 * * * *

# ---------- Website builder (or Admin -> Integrations -> Website Builder) ----------
WEBSITE_BUILDER_API=https://webgmbapi.hovermedia.in/api
WEBSITE_BUILDER_PANEL=https://gmbemployee.hovermedia.in
WEBSITE_BUILDER_KEY=

# ---------- Meta: Facebook page + Instagram (or Admin -> Integrations -> Meta) ----------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# META_REDIRECT_URI defaults to APP_URL/api/social/callback

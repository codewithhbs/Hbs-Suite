{
  "name": "hbs-suite-backend",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "HBS Suite API - Express modular monolith (MySQL + Redis + BullMQ)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/index.js",
    "worker:dev": "node --watch --env-file-if-exists=.env src/workers/index.js",
    "job": "node src/jobs/run.js",
    "db:setup": "node scripts/seed.js",
    "db:migrate": "node scripts/migrate.js",
    "own-company": "node scripts/create-own-company.mjs",
    "postman": "node scripts/build-postman.mjs",
    "check": "node scripts/check-imports.js",
    "fix:duplicates": "node scripts/fix-duplicates.js"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.28",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.56.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "mysql2": "^3.24.2",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.1",
    "react": "19.2.8",
    "satori": "^0.15.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}

# Leave empty (recommended): the app calls /api on the same domain
# (Nginx in production, the Vite proxy in development).
# Set only if the API runs on another same-site host, e.g. https://api.hbssuite.com
VITE_API_URL=

# Dev only: where the Vite proxy sends /api
VITE_DEV_API=http://127.0.0.1:4000

# Public app URL (share links). Defaults to window.location.origin
VITE_APP_URL=

VITE_IMAGE_REGEN_LIMIT=2
